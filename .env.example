# =============================================================================
# Aula Especializate · Planillas inteligentes — gateway LTI 1.3
# Copiar a .env y completar. .env NO se sube al repositorio.
# =============================================================================

# --- Servidor ---------------------------------------------------------------
# Puerto local. En la VM, iniciación usa 3000 y planillas 3001 (Nginx reenvía).
PORT=3001
NODE_ENV=production
# Solo el ORIGEN público (https://host), sin ruta.
PUBLIC_BASE_URL=https://especializate.bue.edu.ar
# Prefijo público de TODAS las rutas del gateway. Nginx lo reenvía sin modificarlo.
# Para desarrollo local sin prefijo, dejarlo vacío.
BASE_PATH=/aula/planillas
# Nombre de la cookie de sesión (default planillas_lti_sid). Va acotada a BASE_PATH.
#SESSION_COOKIE_NAME=planillas_lti_sid

# --- Sesión -----------------------------------------------------------------
# Cadena aleatoria de al menos 32 caracteres:  openssl rand -base64 48
SESSION_SECRET=
# Duración de la sesión en minutos (default 240).
#SESSION_TTL_MIN=240

# --- Moodle / LTI 1.3 (los da el administrador de Moodle) ---------------------
LTI_ISSUER=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_AUTH_LOGIN_URL=
LTI_JWKS_URL=
#LTI_TOKEN_URL=
MOODLE_URL=
# Opcionales: clave privada propia de la herramienta (si no, se genera en .keys/).
#LTI_TOOL_PRIVATE_KEY=
#LTI_TOOL_KID=
# Solo si Moodle abre el aula dentro de un iframe (requiere HTTPS).
#EMBED_IN_IFRAME=false

# --- Progreso -----------------------------------------------------------------
# remote = el servidor es la fuente de verdad (default) | local = SIN persistencia (solo desarrollo)
PROGRESS_MODE=remote
# springboot (producción) | memory | file (solo desarrollo; NO son durables)
PROGRESS_STORE=springboot
# Backend planillasInteligentes (incluye el contexto del WAR: /planillas)
SPRING_BOOT_URL=http://localhost:8080/planillas
# Mismo valor que PLANILLAS_INTERNAL_API_SECRET del backend (mínimo 32 caracteres).
# Debe ser DISTINTO al de iniciación.  openssl rand -base64 48
INTERNAL_API_SECRET=
# Curso que atiende este gateway; debe coincidir con PLANILLAS_COURSE_ID del backend.
COURSE_ID=planillas
#SPRING_BOOT_TIMEOUT_MS=5000

# --- Solo desarrollo (nunca en producción) -------------------------------------
# Simula un launch de Moodle en BASE_PATH/dev/launch.
#DEV_FAKE_LAUNCH=true
